<div
  class="custom-carousel"
  id="CustomCarousel-{{ section.id }}"
>

  <div class="custom-carousel__viewport">

    <div class="custom-carousel__container">

      {% for block in section.blocks %}

        <div
          class="custom-carousel__slide"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.image != blank %}

            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                class: 'custom-carousel__image'
            }}

          {% endif %}

          <div class="custom-carousel__content">

            {% if block.settings.heading != blank %}
              <h2>
                {{ block.settings.heading }}
              </h2>
            {% endif %}

            {% if block.settings.text != blank %}
              <p>
                {{ block.settings.text }}
              </p>
            {% endif %}

          </div>

        </div>

      {% endfor %}

    </div>

  </div>

  {% if section.blocks.size > 1 %}

    <button
      type="button"
      class="custom-carousel__button custom-carousel__button--prev"
      aria-label="Previous slide"
    >
      ←
    </button>

    <button
      type="button"
      class="custom-carousel__button custom-carousel__button--next"
      aria-label="Next slide"
    >
      →
    </button>

  {% endif %}

</div>

{% schema %}
{
  "name": "Custom Carousel",

  "settings": [],

  "blocks": [
    {
      "type": "slide",
      "name": "Slide",

      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Slide heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Slide description"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Custom Carousel",

      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}