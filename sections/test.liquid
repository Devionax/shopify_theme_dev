<style>
  .test-p{
    font-size: {{ section.settings.paragraph_font }}px ;
  }
  .head-color{
  color: {{ section.settings.heading_color }}
  }
</style>

<div>
  <h1 class="test-p head-color">{{ section.settings.heading }}</h1>
  <p class="test-p">{{ section.settings.paragraph_UVI }}</p>
</div>

<div>
  <ol>
    {% for block in section.blocks %}
    {% if  block.type == "collection-list" %}
    <li >
      <strong>{{ block.settings.coll_list }}</strong>

      <ul>
        <li>{{ block.settings.coll_list_desc }}</li>
      </ul>
    </li>
  {% endif %}
  {% endfor %}
</ol>
</div>

{% schema %}
{
  "name": "test",
  "tag": "aside",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "this is liquid section!"
    },
    {
      "type": "text",
      "id": "paragraph_UVI",
      "label": "Paragraph Text",
      "default": "Liquid section paragraph!"
    },
    {
      "type": "range",
      "id": "paragraph_font",
      "label": "Paragraph font",
      "min": 10,
      "max": 30,
      "step": 2,
      "default": 20
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "set Heading color",
      "default": "#0000FF"
    }
  ],
  "blocks": [
    {
      "type": "collection-list",
      "name": "collection block",
      "settings": [
        {
          "type": "text",
          "id": "coll_list",
          "label": "Collection entry"
        },
        {
          "type": "text",
          "id": "coll_list_desc",
          "label": "Collection entry description"
        }
      ]
    },
    {
    "type": "collection_faq",
    "name": "Collection FAQ",
    "settings": [
      {"type": "text",
        "id": "coll_faq_q",
        "label": "Question's FAQ"
      },
      {"type": "text",
        "id": "coll_faq_a",
        "label": "Answer's FAQ"
      },
    ]
    }
  ],
  "presets": [
    {
      "name": "uvi_block"
    }
  ]
}
{% endschema %}
