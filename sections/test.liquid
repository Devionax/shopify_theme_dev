<style>
  .test-p{
    font-size: {{ section.settings.paragraph_font }}px ;
  }
  .head-color{
  color: {{ section.settings.heading_color }}
  }
  .faq_coll{
  display:flex;
  justify-content:center;
  align-items:center;
  }
</style>

<div>
  <h1 class="test-p head-color">{{ section.settings.heading }}</h1>
  <p class="test-p">{{ section.settings.paragraph_UVI }}</p>
</div>

<my-cart-button></my-cart-button>

{% comment %} <div>
  {% for block in section.blocks %}
    {% if block.type == 'collection-list' %}
        <ol>
        <li>
          <strong>{{ block.settings.coll_list }}</strong>

          <ul>
            <li>{{ block.settings.coll_list_desc }}</li>
          </ul>
        </li>
      </ol>
      {% elsif block.type == 'collection_faq' %}
        <div class="faq_coll">
        <details>
          <summary>{{ block.settings.coll_faq_q }}</summary>

          <p>{{ block.settings.coll_faq_a }}.</p>
        </details>
      </div>
      {% endif %}
    {% endfor %}
</div> {% endcomment %}

{% schema %}
{
  "name": "test",
  "tag": "aside",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "this is liquid section!"
    },
    {
      "type": "text",
      "id": "paragraph_UVI",
      "label": "Paragraph Text",
      "default": "Liquid section paragraph!"
    },
    {
      "type": "range",
      "id": "paragraph_font",
      "label": "Paragraph font",
      "min": 10,
      "max": 30,
      "step": 2,
      "default": 20
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "set Heading color",
      "default": "#0000FF"
    }
  ],
  "blocks": [
    {
      "type": "_collection-list"
    },
    {
      "type": "_collection-faq"
    }
  ],
  "presets": [
    {
      "name": "uvi_block"
    }
  ]
}
{% endschema %}



<script> 
  class MyCartButton extends HTMLElement {

  connectedCallback() {

    this.innerHTML = `
      <button>
        Add to cart
      </button>
    `;

    this.querySelector('button').addEventListener('click', () => {
      console.log('Button clicked');
    });

  }

}

customElements.define(
  'my-cart-button',
  MyCartButton
);
</script>