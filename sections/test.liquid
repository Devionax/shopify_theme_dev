<style>
.test-p{
  font-size: {{ section.settings.paragraph_font }}px ;
}
.head-color{
color: {{ section.settings.heading_color }}
}

</style>

<div>
  <h1 class="test-p head-color">{{ section.settings.heading }}</h1>
  <p class="test-p">{{ section.settings.paragraph_UVI }}</p>
</div>

<div>
 <ol>
  <li>
{{  }}
  </li>
  </ol>
</div>

{% schema %}

  {
    "name": "test",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading Text",
        "default": "this is liquid section!"
      }, {
        "type": "text",
        "id": "paragraph_UVI",
        "label": "Paragraph Text",
        "default": "Liquid section paragraph!"
      }
      , {
        "type": "range",
        "id": "paragraph_font",
        "label": "Paragraph font",
        "min": 10,
        "max": 30,
        "step": 2,
        "default": 20
      },{
      "type": "color",
      "id": "heading_color",
      "label": "set Heading color",
      "default" : "#0000FF"
      }
    ],
    "blocks": [
      {
      "type": "collection-list",
      "name":"Collections",
      "settings": [
        {
        "type": "text",
        "id": "coll-list",
        "label": "Collection entry"
        }
      ]
      }
    ],
    "presets": [
      {
        "name": "uvi_block"
      }
    ]
  }

{% endschema %}