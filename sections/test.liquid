
<div>
<h1>{{ section.settings.heading }}</h1>
<p>{{  section.settings.paragraph }}</p>
</div>

{%schema %}

{
"name": "test",
"settings": [
    {
    "type": "text",
    "id": "heading",
    "label": "Heading Text",
    "default" :"this is liquid section!"
    },
    {
    "type": "richtext",
    "id": "paragraph",
    "label": "paragraph Text",
    "default" :"This is liquid section paragraph!"
    },
],
"blocks": [],
"presets": [
    {
        "name": "uvi_block"
    }
]
}

{% endschema %}