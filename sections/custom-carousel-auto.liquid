<div
  class="custom-carousel"
  id="CustomCarousel-{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
>
  
  <div class="custom-carousel__viewport">

    <div class="custom-carousel__container">

      {% for block in section.blocks %}

        <div
          class="custom-carousel__slide"
          {{ block.shopify_attributes }}
        >

          <div class="custom-carousel__card">

            {% if block.settings.badge != blank %}
              <span class="custom-carousel__badge">
                {{ block.settings.badge }}
              </span>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h2 class="custom-carousel__heading">
                {{ block.settings.heading }}
              </h2>
            {% endif %}

            {% if block.settings.text != blank %}
              <p class="custom-carousel__text">
                {{ block.settings.text }}
              </p>
            {% endif %}

            {% if block.settings.button_text != blank
              and block.settings.button_link != blank
            %}

              <a
                href="{{ block.settings.button_link }}"
                class="custom-carousel__button-link"
              >
                {{ block.settings.button_text }}
              </a>

            {% endif %}

          </div>

        </div>

      {% endfor %}

    </div>

  </div>


  {% if section.blocks.size > 1 %}

    <button
      type="button"
      class="custom-carousel__arrow custom-carousel__arrow--prev"
      aria-label="Previous slide"
    >
      &#8592;
    </button>

    <button
      type="button"
      class="custom-carousel__arrow custom-carousel__arrow--next"
      aria-label="Next slide"
    >
      &#8594;
    </button>

  {% endif %}

</div>


{% schema %}

{
  "name": "Autoplay Carousel",

  "settings": [

    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },

    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay delay",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "default": 4,
      "visible_if": "{{ section.settings.autoplay }}"
    }

  ],

  "blocks": [

    {
      "type": "slide",
      "name": "Card",

      "settings": [

        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Featured"
        },

        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Amazing product"
        },

        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "This is a beautiful carousel card."
        },

        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Learn more"
        },

        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }

      ]
    }

  ],

  "presets": [

    {
      "name": "Autoplay Carousel",

      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }

  ]

}

{% endschema %}