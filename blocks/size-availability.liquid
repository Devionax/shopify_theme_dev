<section class="size-availability">

  <div class="size-availability__trigger">

    <button
      type="button"
      class="size-availability__open"
      data-open
    >
      Check size availability
    </button>

  </div>


  <size-availability-modal>

    <dialog class="size-availability__dialog">

      <div class="size-availability__modal">

        <!-- Header -->
        <div class="size-availability__header">

          <div>
            <h2 class="size-availability__title">
              Size availability
            </h2>

            <p class="size-availability__subtitle">
              Check the available sizes for this product.
            </p>
          </div>


          <button
            type="button"
            class="size-availability__close"
            data-close
            aria-label="Close size availability"
          >
            &times;
          </button>

        </div>


        <!-- Size table -->
        <div class="size-availability__table-wrapper">

          <table class="size-availability__table">

            <thead>
              <tr>
                <th>Size</th>
                <th>Chest</th>
                <th>Length</th>
                <th>Availability</th>
              </tr>
            </thead>


            <tbody>

              <!-- Small -->
              <tr>
                <td>
                  <strong>S</strong>
                </td>

                <td>
                  36"
                </td>

                <td>
                  27"
                </td>

                <td>
                  <span class="size-status size-status--available">
                    Available
                  </span>
                </td>
              </tr>


              <!-- Medium -->
              <tr>
                <td>
                  <strong>M</strong>
                </td>

                <td>
                  38"
                </td>

                <td>
                  28"
                </td>

                <td>
                  <span class="size-status size-status--available">
                    Available
                  </span>
                </td>
              </tr>


              <!-- Large -->
              <tr>
                <td>
                  <strong>L</strong>
                </td>

                <td>
                  40"
                </td>

                <td>
                  29"
                </td>

                <td>
                  <span class="size-status size-status--available">
                    Available
                  </span>
                </td>
              </tr>


              <!-- XL -->
              <tr>
                <td>
                  <strong>XL</strong>
                </td>

                <td>
                  42"
                </td>

                <td>
                  30"
                </td>

                <td>
                  <span class="size-status size-status--sold-out">
                    Sold out
                  </span>
                </td>
              </tr>


              <!-- XXL -->
              <tr>
                <td>
                  <strong>XXL</strong>
                </td>

                <td>
                  44"
                </td>

                <td>
                  31"
                </td>

                <td>
                  <span class="size-status size-status--available">
                    Available
                  </span>
                </td>
              </tr>

            </tbody>

          </table>

        </div>


        <!-- Footer -->
        <div class="size-availability__footer">

          <button
            type="button"
            class="size-availability__done"
            data-close
          >
            Done
          </button>

        </div>

      </div>

    </dialog>

  </size-availability-modal>

</section>


<style>

  /* =========================
     SECTION
  ========================= */

  .size-availability {
    width: 100%;
    margin: 20px 0;
  }


  /* =========================
     OPEN BUTTON
  ========================= */

  .size-availability__open {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 12px 18px;

    border: 1px solid #222;
    border-radius: 6px;

    background: #fff;
    color: #222;

    font-size: 14px;
    font-weight: 500;

    cursor: pointer;

    transition:
      background 0.2s ease,
      color 0.2s ease;
  }


  .size-availability__open:hover {
    background: #222;
    color: #fff;
  }


  /* =========================
     NATIVE DIALOG
  ========================= */

  .size-availability__dialog {
    width: min(700px, calc(100% - 32px));

    max-height: calc(100vh - 32px);

    padding: 0;

    border: none;

    border-radius: 12px;

    background: #fff;

    overflow: hidden;
  }


  /*
    Background behind the dialog
  */

  .size-availability__dialog::backdrop {
    background: rgba(0, 0, 0, 0.55);
  }


  /* =========================
     MODAL
  ========================= */

  .size-availability__modal {
    display: flex;

    flex-direction: column;

    max-height: calc(100vh - 32px);
  }


  /* =========================
     HEADER
  ========================= */

  .size-availability__header {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 20px;

    padding: 24px;

    border-bottom: 1px solid #e5e5e5;
  }


  .size-availability__title {
    margin: 0 0 6px;

    font-size: 22px;

    line-height: 1.3;
  }


  .size-availability__subtitle {
    margin: 0;

    color: #666;

    font-size: 14px;

    line-height: 1.5;
  }


  /* =========================
     CLOSE BUTTON
  ========================= */

  .size-availability__close {
    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    width: 36px;

    height: 36px;

    padding: 0;

    border: none;

    background: transparent;

    color: #222;

    font-size: 28px;

    line-height: 1;

    cursor: pointer;
  }


  /* =========================
     TABLE
  ========================= */

  .size-availability__table-wrapper {
    overflow-x: auto;

    padding: 0 24px;
  }


  .size-availability__table {
    width: 100%;

    min-width: 560px;

    border-collapse: collapse;
  }


  .size-availability__table th,
  .size-availability__table td {
    padding: 16px 12px;

    text-align: left;

    border-bottom: 1px solid #e5e5e5;

    font-size: 14px;
  }


  .size-availability__table th {
    color: #666;

    font-size: 12px;

    font-weight: 600;

    text-transform: uppercase;

    letter-spacing: 0.04em;
  }


  .size-availability__table td:first-child {
    padding-left: 0;
  }


  .size-availability__table th:first-child {
    padding-left: 0;
  }


  /* =========================
     STATUS
  ========================= */

  .size-status {
    display: inline-flex;

    align-items: center;

    padding: 5px 9px;

    border-radius: 999px;

    font-size: 12px;

    font-weight: 500;

    white-space: nowrap;
  }


  .size-status--available {
    background: #eaf7ee;

    color: #19733a;
  }


  .size-status--sold-out {
    background: #f3f3f3;

    color: #777;
  }


  /* =========================
     FOOTER
  ========================= */

  .size-availability__footer {
    display: flex;

    justify-content: flex-end;

    padding: 20px 24px;
  }


  .size-availability__done {
    padding: 11px 22px;

    border: none;

    border-radius: 6px;

    background: #222;

    color: #fff;

    font-size: 14px;

    cursor: pointer;
  }


  /* =========================
     MOBILE
  ========================= */

  @media screen and (max-width: 600px) {

    .size-availability__dialog {
      width: calc(100% - 20px);

      max-height: calc(100vh - 20px);

      border-radius: 10px;
    }


    .size-availability__header {
      padding: 18px;
    }


    .size-availability__title {
      font-size: 19px;
    }


    .size-availability__table-wrapper {
      padding: 0 18px;
    }


    .size-availability__footer {
      padding: 16px 18px;
    }

  }

</style>


