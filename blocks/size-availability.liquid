<size-availability-modal class="size-availability">

  <!-- Trigger Button inside custom element -->
  <div class="size-availability__trigger">
    <button
      type="button"
      class="size-availability__open"
      data-open
    >
      Check size availability
    </button>
  </div>

  <!-- Native HTML5 Dialog -->
  <dialog class="size-availability__dialog">
    <div class="size-availability__modal">

      <!-- Header -->
      <div class="size-availability__header">
        <div>
          <h2 class="size-availability__title">Size availability</h2>
          <p class="size-availability__subtitle">
            Check the available sizes for this product.
          </p>
        </div>

        <button
          type="button"
          class="size-availability__close"
          data-close
          aria-label="Close size availability"
        >
          &times;
        </button>
      </div>

      <!-- Static Size Table -->
      <div class="size-availability__table-wrapper">
        <table class="size-availability__table">
          <thead>
            <tr>
              <th>Size</th>
              <th>Chest</th>
              <th>Length</th>
              <th>Availability</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>S</strong></td>
              <td>36"</td>
              <td>27"</td>
              <td><span class="size-status size-status--available">Available</span></td>
            </tr>
            <tr>
              <td><strong>M</strong></td>
              <td>38"</td>
              <td>28"</td>
              <td><span class="size-status size-status--available">Available</span></td>
            </tr>
            <tr>
              <td><strong>L</strong></td>
              <td>40"</td>
              <td>29"</td>
              <td><span class="size-status size-status--available">Available</span></td>
            </tr>
            <tr>
              <td><strong>XL</strong></td>
              <td>42"</td>
              <td>30"</td>
              <td><span class="size-status size-status--sold-out">Sold out</span></td>
            </tr>
            <tr>
              <td><strong>XXL</strong></td>
              <td>44"</td>
              <td>31"</td>
              <td><span class="size-status size-status--available">Available</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Footer -->
      <div class="size-availability__footer">
        <button
          type="button"
          class="size-availability__done"
          data-close
        >
          Done
        </button>
      </div>

    </div>
  </dialog>

</size-availability-modal>

<style>
  /* ========================================
   SIZE AVAILABILITY
======================================== */

.size-availability {
  display: block;
  width: 100%;
  margin: 20px 0;
}


/* ========================================
   OPEN BUTTON
======================================== */

.size-availability__open {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 12px 18px;

  border: 1px solid #222;
  border-radius: 6px;

  background: #fff;
  color: #222;

  font-size: 14px;
  font-weight: 500;

  cursor: pointer;

  transition:
    background 0.2s ease,
    color 0.2s ease;
}

.size-availability__open:hover {
  background: #222;
  color: #fff;
}


/* ========================================
   DIALOG
======================================== */

.size-availability__dialog {
  width: min(700px, calc(100% - 32px));
  max-height: calc(100vh - 32px);

  margin: auto;

  padding: 0;

  border: none;
  border-radius: 12px;

  background: #fff;

  overflow: hidden;

  /*
   * Initial state
   */
  opacity: 0;
  transform: scale(0.8);

  /*
   * Smooth animation
   */
  transition:
    opacity 0.3s ease,
    transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}


/* ========================================
   OPEN STATE
======================================== */

.size-availability__dialog.is-open {
  opacity: 1;
  transform: scale(1);
}


/* ========================================
   BACKDROP
======================================== */

.size-availability__dialog::backdrop {
  background: rgba(0, 0, 0, 0);

  transition:
    background 0.3s ease;
}


/* Backdrop when modal is open */

.size-availability__dialog.is-open::backdrop {
  background: rgba(0, 0, 0, 0.55);
}


/* Backdrop while closing */

.size-availability__dialog.is-closing::backdrop {
  background: rgba(0, 0, 0, 0);
}


/* ========================================
   CLOSING
======================================== */

.size-availability__dialog.is-closing {
  opacity: 0;
  transform: scale(0.8);
}


/* ========================================
   MODAL CONTAINER
======================================== */

.size-availability__modal {
  display: flex;
  flex-direction: column;

  width: 100%;

  max-height: calc(100vh - 32px);
}


/* ========================================
   HEADER
======================================== */

.size-availability__header {
  display: flex;

  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  padding: 24px;

  border-bottom: 1px solid #e5e5e5;
}


/* ========================================
   TITLE
======================================== */

.size-availability__title {
  margin: 0 0 6px;

  font-size: 22px;
  line-height: 1.3;
}


/* ========================================
   SUBTITLE
======================================== */

.size-availability__subtitle {
  margin: 0;

  color: #666;

  font-size: 14px;
  line-height: 1.5;
}


/* ========================================
   CLOSE BUTTON
======================================== */

.size-availability__close {
  display: flex;

  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  width: 36px;
  height: 36px;

  padding: 0;

  border: none;

  background: transparent;
  color: #222;

  font-size: 28px;
  line-height: 1;

  cursor: pointer;

  transition:
    background 0.2s ease,
    color 0.2s ease;
}

.size-availability__close:hover {
  background: #f5f5f5;

  border-radius: 50%;
}


/* ========================================
   TABLE WRAPPER
======================================== */

.size-availability__table-wrapper {
  overflow-x: auto;

  padding: 0 24px;

  /*
   * Allow table area to scroll vertically
   * on smaller screens if necessary.
   */
  overflow-y: auto;
}


/* ========================================
   TABLE
======================================== */

.size-availability__table {
  width: 100%;

  min-width: 560px;

  border-collapse: collapse;
}


/* ========================================
   TABLE CELLS
======================================== */

.size-availability__table th,
.size-availability__table td {
  padding: 16px 12px;

  text-align: left;

  border-bottom: 1px solid #e5e5e5;

  font-size: 14px;
}


/* ========================================
   TABLE HEADER
======================================== */

.size-availability__table th {
  color: #666;

  font-size: 12px;
  font-weight: 600;

  text-transform: uppercase;

  letter-spacing: 0.04em;
}


/* ========================================
   FIRST COLUMN
======================================== */

.size-availability__table td:first-child,
.size-availability__table th:first-child {
  padding-left: 0;
}


/* ========================================
   STATUS
======================================== */

.size-status {
  display: inline-flex;

  align-items: center;

  padding: 5px 9px;

  border-radius: 999px;

  font-size: 12px;
  font-weight: 500;

  white-space: nowrap;
}


/* Available */

.size-status--available {
  background: #eaf7ee;
  color: #19733a;
}


/* Sold out */

.size-status--sold-out {
  background: #f3f3f3;
  color: #777;
}


/* ========================================
   FOOTER
======================================== */

.size-availability__footer {
  display: flex;

  justify-content: flex-end;

  padding: 20px 24px;
}


/* ========================================
   DONE BUTTON
======================================== */

.size-availability__done {
  padding: 11px 22px;

  border: none;
  border-radius: 6px;

  background: #222;
  color: #fff;

  font-size: 14px;

  cursor: pointer;

  transition:
    background 0.2s ease,
    transform 0.15s ease;
}

.size-availability__done:hover {
  background: #000;
}

.size-availability__done:active {
  transform: scale(0.97);
}


/* ========================================
   MOBILE
======================================== */

@media screen and (max-width: 600px) {

  .size-availability__dialog {
    width: calc(100% - 20px);

    max-height: calc(100vh - 20px);

    border-radius: 10px;
  }


  .size-availability__modal {
    max-height: calc(100vh - 20px);
  }


  .size-availability__header {
    padding: 18px;
  }


  .size-availability__title {
    font-size: 19px;
  }


  .size-availability__subtitle {
    font-size: 13px;
  }


  .size-availability__table-wrapper {
    padding: 0 18px;
  }


  .size-availability__table th,
  .size-availability__table td {
    padding: 14px 10px;
  }


  .size-availability__footer {
    padding: 16px 18px;
  }


  .size-availability__done {
    padding: 10px 18px;
  }

}
</style>

{% schema %}
{
  "name": "Size availability",
  "settings": [],
  "presets": [
    {
      "name": "Size availability"
    }
  ]
}
{% endschema %}