{%- liquid
  assign product = closest.product
  assign brands = product.metafields.decoop.brand.value
-%}

{% if brands != blank %}
  <div
    class="product-brand"
    {{ block.shopify_attributes }}
  >
    <span class="product-brand__label">
      Brand:
    </span>

    <div class="product-brand__list">
      {% for brand in brands %}
        <span class="product-brand__item">
          {{ brand }}
        </span>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
.product-brand{
  display:flex;
  align-items:center;
  gap:10px;
  margin:12px 0;
  flex-wrap:wrap;
}

.product-brand__label{
  font-weight:600;
}

.product-brand__list{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

.product-brand__item{
  padding:4px 10px;
  border:1px solid #ddd;
  border-radius:20px;
  font-size:14px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Product Brand",
  "settings": []
}
{% endschema %}