<div class="static-message" {{ block.shopify_attributes }}>
  <h2>
    {{ block.settings.heading }}
  </h2>

  <p>
    {{ block.settings.message }}
  </p>
</div>

{% schema %}
{
  "name": "Static Message",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hello from static block"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Message",
      "default": "This block is rendered directly by Liquid code."
    }
  ],
  "presets": [
    {
        "name": "Static message"
    }
  ]
}
{% endschema %}